# Copy this to Netlify → Site configuration → Environment variables.
# Never commit real values to git.

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key       # server-only, secret — used by Netlify Functions
SUPABASE_ANON_KEY=your_supabase_anon_key               # public, safe for the browser

# --- Cashfree (Merchant Dashboard → Developers → API Keys) ---
CASHFREE_ENV=sandbox                    # 'sandbox' while testing, 'production' to go live
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret             # Developers → Webhooks → Secret


# --- Resend (resend.com — free 3000 emails/month) ---
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=orders@yourdomain.com
RESEND_FROM_NAME=Zivogift
ADMIN_NOTIFY_EMAIL=your_inbox@example.com      # where new-order alerts go


# --- Meta WhatsApp Cloud API (replaces AiSensy entirely) ---
# See whatsapp.js header comment for one-time setup (20 min, free).
WHATSAPP_TOKEN=your_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# Set by you (any string you choose) when configuring the webhook in Meta's
# console — Meta echoes it back on the verification handshake (GET request).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose_any_random_string
# App Dashboard → Settings → Basic → App Secret. Required — whatsapp-webhook.js
# rejects every inbound POST if this isn't set, since it's what verifies a
# request actually came from Meta (X-Hub-Signature-256 header) and not from
# anyone who found the webhook URL.
WHATSAPP_APP_SECRET=your_meta_app_secret

# Template names — approve each in Meta Business Manager → WhatsApp Manager → Message Templates
# Category: UTILITY (cheaper, faster approval)
WHATSAPP_TEMPLATE_NAME=zivogift_birthday_surprise         # gift delivery to recipient
WHATSAPP_TEMPLATE_DELIVERED=gift_delivered_sender_notify  # tells sender gift was delivered
WHATSAPP_TEMPLATE_OPENED=gift_opened_sender_notify        # tells sender gift was opened
WHATSAPP_TEMPLATE_REPLY_RECEIVED=gift_reply_received      # tells anon sender they got a reply
WHATSAPP_TEMPLATE_SQUAD_INVITE=squad_reaction_invite      # invites squad contributors

SITE_URL=https://zivogift.com           # used to build gift URLs and function self-calls

# --- Cloudflare R2 (for generated card images) ---
# Cloudflare Dashboard → R2 → your bucket → Settings → API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=zivogift-cards
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_PUBLIC_URL=https://pub-XXXX.r2.dev   # Enable "Public Access" on the bucket and paste the URL

# --- Meta WhatsApp Cloud API (Group 2 additions) ---
# New template names to approve in Meta Business Manager:
WHATSAPP_TEMPLATE_REACTION_INVITE=squad_reaction_invite
WHATSAPP_TEMPLATE_REPLY_RECEIVED=gift_reply_received

# --- Gemini (Group 4 additions) ---
# aistudio.google.com/apikey → Create API key. Free tier, no card required,
# ~1,500 requests/day on gemini-2.5-flash as of writing. Used server-side
# (never exposed to the browser) by netlify/functions/_lib/anthropicHelper.js
# — filename kept as-is to avoid touching every file that requires() it,
# but it calls Google's Gemini API, not Anthropic's, as of Jul 2026 (the
# Anthropic account behind the old key ran out of billing credit and it
# wasn't renewed). Used for the Currency Note Story Card (#14), Numerology
# Upgrade (#22), AI Polish, content moderation, and safety checks. If unset,
# these features fall back to a static template instead of failing the order.
GEMINI_API_KEY=your_gemini_api_key

# --- Group 5 additions ---
# No new secrets — Zivo Pass, Campus Rep payouts, College Vibes, and Occasion
# Intelligence all reuse Cashfree, Resend, WhatsApp Cloud API, and Supabase
# exactly as configured above. One new WhatsApp template to approve:
WHATSAPP_TEMPLATE_OCCASION_NUDGE=zg_occasion_nudge   # college-calendar nudge (exams/placements/freshers/graduation)
# --- Sender phone verification (MSG91 OTP Widget — checkout hardening) ---
# Required once per account (My Account → Verify Mobile Number) — see
# SETUP.md "MSG91 SMS OTP setup" section for the full walkthrough.
#
# IMPORTANT: this is now the WIDGET flow, not the raw SendOTP API — the
# Widget has its own default template that works without DLT/GST at all
# (confirmed directly with MSG91 support), unlike the raw API below which
# needs your DLT Entity ID mapped even for its "default template."
#
# Two of the three values below are PUBLIC and do NOT go in this file or
# Netlify env — they're client-side and go in js/config.js instead:
#   MSG91_WIDGET_ID          → js/config.js
#   MSG91_WIDGET_TOKEN_AUTH  → js/config.js (safe to expose — MSG91 designed
#                               it specifically so the real Authkey doesn't
#                               have to appear in browser code)
# Only the account Authkey below is a real secret and belongs here /
# in Netlify env — it's used server-side to independently re-confirm the
# widget's access-token before trusting it (see verify-sender-otp.js).
MSG91_AUTH_KEY=your_msg91_auth_key

# --- Unused by the current flow — kept for _lib/msg91.js's sendOtp/verifyOtp,
# the raw SendOTP API functions, in case you ever want that path instead of
# the Widget above (e.g. once you're DLT-registered and want a branded,
# non-widget template). Not required for the Widget flow to work. ---
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
# --- Optional: malware scanning for uploaded media (_lib/mediaValidation.js) ---
# virustotal.com → free signup → API Key. If unset, magic-byte content
# validation and image re-encoding still run on every upload (no key
# needed for those) — only the virus-scan step is skipped, and it's
# logged as skipped rather than silently treated as clean.
VIRUSTOTAL_API_KEY=
# --- Care Package feature ---
# TWO new templates needed, both must be Meta-approved before this feature works.
# zg_care_package_daily body: "{{1}} set this up for you: {{2}}" (sender name, message text)
#   — this is a single large free-text variable, same approval-risk caveat as
#   the OTP template above (Meta sometimes rejects templates that are mostly
#   one free-text placeholder). Test approval early, don't assume it'll pass.
WHATSAPP_TEMPLATE_CARE_DAILY=zg_care_package_daily
# zg_care_package_complete body: "Hey {{1}}, your care package sequence just
#   finished sending — hope it meant something to them. — Zivogift"
WHATSAPP_TEMPLATE_CARE_COMPLETE=zg_care_package_complete
